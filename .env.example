# Optional: copy to .env. Real environment variables take precedence.
TRADING_MODE=PAPER
# true is rejected. LIVE remains unavailable regardless of credentials.
ENABLE_LIVE_TRADING=false
SYMBOL=BTC/EUR
TIMEFRAME=15m
INITIAL_CAPITAL=1000
DATABASE_PATH=data/trading.sqlite3
LOG_DIRECTORY=logs
LOG_LEVEL=INFO
PAPER_FEE_RATE=0.0026
PAPER_SLIPPAGE_BPS=5
PAPER_SPREAD_BPS=0
PRICE_TICK=0.01
QUANTITY_STEP=0.00000001
MIN_ORDER_NOTIONAL=5
MIN_ORDER_QUANTITY=0
# Simulation assumptions, not Kraken's current fees or instrument specifications.
# BACKTEST uses stop-based risk checks. The shipped strategy still always HOLDs.
MAX_LEVERAGE=1
MAX_RISK_PER_TRADE=0.01
MAX_TOTAL_RISK=0.03
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.10
MAX_POSITIONS=1
MIN_LIQUIDATION_DISTANCE=0.10
# Liquidation distance is reserved for future derivatives; current execution is cash-funded 1x.
MAX_POSITION_NOTIONAL=1000
KILL_SWITCH=false
# No credentials are needed, read, or used in this version.
